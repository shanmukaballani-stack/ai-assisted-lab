FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///quizmaster.sqlite
SESSION_COOKIE_SECURE=false
LEADERBOARD_ENABLED=true
